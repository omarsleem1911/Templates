{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "**cor. Event Hub integration.** Creates the Event Hubs namespace, the event hub, its shared access policy and the storage account cor. uses for checkpoints. Keep the cor. page open: it connects the Event Hub as soon as the deployment succeeds.",
        "location": {
          "label": "Region",
          "toolTip": "Every resource is created in this region.",
          "resourceTypes": [
            "Microsoft.EventHub/namespaces",
            "Microsoft.Storage/storageAccounts"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "namespaceApi",
        "type": "Microsoft.Solutions.ArmApiControl",
        "request": {
          "method": "POST",
          "path": "[concat(subscription().id, '/providers/Microsoft.EventHub/checkNameAvailability?api-version=2024-01-01')]",
          "body": {
            "name": "[basics('namespaceName')]"
          }
        }
      },
      {
        "name": "namespaceName",
        "type": "Microsoft.Common.TextBox",
        "label": "Event Hubs namespace name",
        "toolTip": "Globally unique: <name>.servicebus.windows.net",
        "placeholder": "corehnamespace",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-zA-Z][a-zA-Z0-9-]{4,48}[a-zA-Z0-9]$",
              "message": "6-50 characters: letters, numbers and hyphens; start with a letter, end with a letter or number."
            },
            {
              "isValid": "[or(empty(basics('namespaceName')), not(equals(basics('namespaceApi').nameAvailable, false)))]",
              "message": "[concat('Not available: ', basics('namespaceApi').message)]"
            }
          ]
        }
      },
      {
        "name": "eventHubName",
        "type": "Microsoft.Common.TextBox",
        "label": "Event hub name",
        "defaultValue": "coreventhub",
        "constraints": {
          "required": true,
          "regex": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,254}[a-zA-Z0-9])?$",
          "validationMessage": "Letters, numbers, periods, hyphens and underscores; start and end with a letter or number."
        }
      },
      {
        "name": "storageApi",
        "type": "Microsoft.Solutions.ArmApiControl",
        "request": {
          "method": "POST",
          "path": "[concat(subscription().id, '/providers/Microsoft.Storage/checkNameAvailability?api-version=2023-05-01')]",
          "body": {
            "name": "[basics('storageAccountName')]",
            "type": "Microsoft.Storage/storageAccounts"
          }
        }
      },
      {
        "name": "storageAccountName",
        "type": "Microsoft.Common.TextBox",
        "label": "Storage account name",
        "toolTip": "Holds the consumer's checkpoints. Globally unique.",
        "placeholder": "corstorage",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-z0-9]{3,24}$",
              "message": "3-24 lowercase letters and numbers."
            },
            {
              "isValid": "[or(empty(basics('storageAccountName')), not(equals(basics('storageApi').nameAvailable, false)))]",
              "message": "[concat('Not available: ', basics('storageApi').message)]"
            }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "advanced",
        "label": "Advanced",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "options": {
              "icon": "Info",
              "text": "The defaults match the cor. Event Hub guide: Basic tier, 1 throughput unit, 2 partitions, 24 hours retention, policy corehSAS, container corcontainer."
            }
          },
          {
            "name": "pricingTier",
            "type": "Microsoft.Common.DropDown",
            "label": "Pricing tier",
            "defaultValue": "Basic",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Basic",
                  "value": "Basic"
                },
                {
                  "label": "Standard",
                  "value": "Standard"
                }
              ]
            }
          },
          {
            "name": "throughputUnits",
            "type": "Microsoft.Common.Slider",
            "label": "Throughput units",
            "min": 1,
            "max": 40,
            "defaultValue": 1,
            "showStepMarkers": false
          },
          {
            "name": "partitionCount",
            "type": "Microsoft.Common.Slider",
            "label": "Partition count",
            "min": 1,
            "max": 32,
            "defaultValue": 2,
            "showStepMarkers": false
          },
          {
            "name": "retentionHours",
            "type": "Microsoft.Common.Slider",
            "label": "Retention time (hours)",
            "subLabel": "Cleanup policy: Delete",
            "toolTip": "Basic tier keeps at most 24 hours (a higher value is capped at 24). Standard: up to 168.",
            "min": 1,
            "max": 168,
            "defaultValue": 24,
            "showStepMarkers": false
          },
          {
            "name": "sharedAccessPolicyName",
            "type": "Microsoft.Common.TextBox",
            "label": "Shared access policy name",
            "defaultValue": "corehSAS",
            "toolTip": "Namespace policy with Manage, Send and Listen.",
            "constraints": {
              "required": true,
              "regex": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,254}$",
              "validationMessage": "Letters, numbers, periods, hyphens and underscores."
            }
          },
          {
            "name": "containerName",
            "type": "Microsoft.Common.TextBox",
            "label": "Checkpoint container name",
            "defaultValue": "corcontainer",
            "constraints": {
              "required": true,
              "regex": "^[a-z0-9](?!.*--)[a-z0-9-]{1,61}[a-z0-9]$",
              "validationMessage": "3-63 lowercase letters, numbers and single hyphens."
            }
          },
          {
            "name": "storageKeyExpirationDays",
            "type": "Microsoft.Common.DropDown",
            "label": "Storage key expiration policy",
            "toolTip": "Azure flags storage keys older than this so they get rotated. They keep working until rotated.",
            "defaultValue": "365 days",
            "constraints": {
              "allowedValues": [
                {
                  "label": "90 days",
                  "value": 90
                },
                {
                  "label": "180 days",
                  "value": 180
                },
                {
                  "label": "365 days",
                  "value": 365
                },
                {
                  "label": "No expiration policy",
                  "value": 0
                }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "namespaceName": "[basics('namespaceName')]",
      "eventHubName": "[basics('eventHubName')]",
      "storageAccountName": "[basics('storageAccountName')]",
      "pricingTier": "[steps('advanced').pricingTier]",
      "throughputUnits": "[steps('advanced').throughputUnits]",
      "partitionCount": "[steps('advanced').partitionCount]",
      "retentionHours": "[steps('advanced').retentionHours]",
      "sharedAccessPolicyName": "[steps('advanced').sharedAccessPolicyName]",
      "containerName": "[steps('advanced').containerName]",
      "storageKeyExpirationDays": "[steps('advanced').storageKeyExpirationDays]"
    }
  }
}
