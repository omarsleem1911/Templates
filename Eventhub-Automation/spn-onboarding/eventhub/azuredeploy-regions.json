{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "cor. log collection, one template for any number of regions: one Event Hub namespace and one event hub per region, and one shared storage account with a checkpoint container per region. The Hub passes the plan as the regions array."
  },
  "parameters": {
    "regions": {
      "type": "array",
      "metadata": {
        "description": "One entry per region: { location, namespaceName, eventHubName, containerName }."
      }
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24
    },
    "storageLocation": {
      "type": "string"
    },
    "pricingTier": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [ "Basic", "Standard" ]
    },
    "throughputUnits": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 20
    },
    "partitionCount": {
      "type": "int",
      "defaultValue": 4,
      "minValue": 1,
      "maxValue": 32
    },
    "retentionHours": {
      "type": "int",
      "defaultValue": 24,
      "minValue": 1,
      "maxValue": 168
    },
    "sharedAccessPolicyName": {
      "type": "string",
      "defaultValue": "corehSAS"
    },
    "storageKeyExpirationDays": {
      "type": "int",
      "defaultValue": 365,
      "minValue": 0,
      "metadata": {
        "description": "Storage key expiration policy in days (0 = no policy)."
      }
    },
    "corConnectionId": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "ehApi": "2024-01-01",
    "stApi": "2023-05-01",
    "tags": {
      "cor-integration": "eventhub",
      "cor-connection-id": "[parameters('corConnectionId')]"
    },
    "retention": "[if(equals(parameters('pricingTier'), 'Basic'), min(parameters('retentionHours'), 24), parameters('retentionHours'))]"
  },
  "resources": [
    {
      "type": "Microsoft.EventHub/namespaces",
      "apiVersion": "[variables('ehApi')]",
      "copy": { "name": "namespaces", "count": "[length(parameters('regions'))]" },
      "name": "[parameters('regions')[copyIndex()].namespaceName]",
      "location": "[parameters('regions')[copyIndex()].location]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('pricingTier')]",
        "tier": "[parameters('pricingTier')]",
        "capacity": "[parameters('throughputUnits')]"
      },
      "properties": {
        "minimumTlsVersion": "1.2"
      }
    },
    {
      "type": "Microsoft.EventHub/namespaces/eventhubs",
      "apiVersion": "[variables('ehApi')]",
      "copy": { "name": "eventhubs", "count": "[length(parameters('regions'))]" },
      "name": "[format('{0}/{1}', parameters('regions')[copyIndex()].namespaceName, parameters('regions')[copyIndex()].eventHubName)]",
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces', parameters('regions')[copyIndex()].namespaceName)]"
      ],
      "properties": {
        "partitionCount": "[parameters('partitionCount')]",
        "retentionDescription": {
          "cleanupPolicy": "Delete",
          "retentionTimeInHours": "[variables('retention')]"
        }
      }
    },
    {
      "type": "Microsoft.EventHub/namespaces/authorizationRules",
      "apiVersion": "[variables('ehApi')]",
      "copy": { "name": "policies", "count": "[length(parameters('regions'))]" },
      "name": "[format('{0}/{1}', parameters('regions')[copyIndex()].namespaceName, parameters('sharedAccessPolicyName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces', parameters('regions')[copyIndex()].namespaceName)]"
      ],
      "properties": {
        "rights": [ "Listen", "Send", "Manage" ]
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "[variables('stApi')]",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('storageLocation')]",
      "tags": "[variables('tags')]",
      "kind": "StorageV2",
      "sku": { "name": "Standard_LRS" },
      "properties": {
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "keyPolicy": "[if(greater(parameters('storageKeyExpirationDays'), 0), createObject('keyExpirationPeriodInDays', parameters('storageKeyExpirationDays')), null())]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "[variables('stApi')]",
      "copy": { "name": "containers", "count": "[length(parameters('regions'))]" },
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('regions')[copyIndex()].containerName)]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    }
  ],
  "outputs": {
    "namespaces": {
      "type": "array",
      "copy": {
        "count": "[length(parameters('regions'))]",
        "input": "[parameters('regions')[copyIndex()].namespaceName]"
      }
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "sharedAccessKeyName": {
      "type": "string",
      "value": "[parameters('sharedAccessPolicyName')]"
    }
  }
}
